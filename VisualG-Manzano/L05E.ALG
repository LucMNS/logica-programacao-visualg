Algoritmo "L05E"
// Disciplina: [Lógica de Programação]
// Professor: Jailson Costa dos Santos
// Descrição: Apresentar todos os valores numéricos inteiros ímpares situados na faixa de 0 a 20.
// Autor(a): Lucas Moreira Nunes de Souza
// Data atual: 26/09/2026

Var
   contador: inteiro

Inicio
   escreval("=========================================")
   escreval("       NÚMEROS ÍMPARES DE 0 A 20         ")
   escreval("=========================================")
   escreval("")

   para contador de 0 ate 20 faca
      se contador % 2 <> 0 entao
         escreval("Número ímpar encontrado: ", contador)
      fimse
   fimpara

   escreval("")
   escreval("-----------------------------------------")
   escreval("Listagem de ímpares concluída!")
   escreval("-----------------------------------------")
   escreval("")

Fimalgoritmo