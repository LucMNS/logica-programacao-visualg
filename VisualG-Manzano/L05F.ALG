Algoritmo "L05F"
// Disciplina: [Lógica de Programação]
// Professor: Jailson Costa dos Santos
// Descrição: Apresentar todos os números divisíveis por 4 que sejam menores que 200.
// Autor(a): Lucas Moreira Nunes de Souza
// Data atual: 26/09/2026

Var
   contador: inteiro

Inicio
   escreval("=========================================")
   escreval("     NÚMEROS DIVISÍVEIS POR 4 (< 200)    ")
   escreval("=========================================")
   escreval("")

   para contador de 1 ate 199 faca
      se contador % 4 = 0 entao
         escreval("Número divisível por 4: ", contador)
      fimse
   fimpara

   escreval("")
   escreval("-----------------------------------------")
   escreval("Listagem finalizada com sucesso!")
   escreval("-----------------------------------------")
   escreval("")

Fimalgoritmo